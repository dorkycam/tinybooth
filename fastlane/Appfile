# Appfile - identifies the iOS app for every Fastlane lane.
#
# All three values come from environment variables so nothing real is
# committed. Camrynn populates these via `fastlane/.env`
# (gitignored); Bundler picks them up because the Fastfile loads `.env`
# before invoking `Spaceship`.
#
#   APP_IDENTIFIER         com.codesquad.tinybooth   (preserved from old app)
#   APPLE_ID               your.apple.id@example.com
#   APPLE_TEAM_ID          ABCDE12345                (10 char Apple team id)
#
# These names also match the EAS submit profiles in eas.json so
# Fastlane and EAS share one source of truth.

app_identifier(ENV["APP_IDENTIFIER"] || "com.codesquad.tinybooth")
apple_id(ENV["APPLE_ID"])
team_id(ENV["APPLE_TEAM_ID"])

# Optional. itc_team_id is sometimes needed when an Apple ID is on multiple
# App Store Connect teams. Leave unset for the common case.
itc_team_id(ENV["ITC_TEAM_ID"]) if ENV["ITC_TEAM_ID"]
