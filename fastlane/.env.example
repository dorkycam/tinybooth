# Copy this file to fastlane/.env and fill in the real values.
# fastlane/.env is gitignored.

# Apple ID and team
APPLE_ID=your.apple.id@example.com
APPLE_TEAM_ID=ABCDE12345
APP_IDENTIFIER=com.codesquad.tinybooth

# Optional. Set if your Apple ID belongs to multiple App Store Connect teams.
# ITC_TEAM_ID=12345678

# App Store Connect API key (preferred over Apple ID + 2FA in CI).
# Generate at https://appstoreconnect.apple.com/access/api
# ASC_API_KEY_ID=ABCDEF1234
# ASC_API_KEY_ISSUER_ID=00000000-0000-0000-0000-000000000000
# ASC_API_KEY_PATH=./secrets/asc-api-key.p8

# FASTLANE_PASSWORD or FASTLANE_SESSION can be set when using Apple ID auth
# in interactive mode. Prefer the API key for CI.
# FASTLANE_PASSWORD=
# FASTLANE_SESSION=
