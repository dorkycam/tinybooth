# Snapfile - configures `fastlane snapshot` for screenshot capture.
#
# Devices we ship to the App Store. Apple requires:
#   - One iPhone 6.7" (or 6.5") screenshot set: iPhone 15 Pro Max.
#   - One iPad Pro 12.9" (3rd gen and later): iPad Pro (12.9-inch, 6th gen).
# Optional but recommended for older-device coverage:
#   - iPhone 11 (6.1") for compat shots.
#
# `snapshot` boots each simulator, runs the `TinyBoothUITests` UI tests, and
# saves PNGs into `fastlane/screenshots/<lang>/<device>/`. `frameit` then adds
# the device frame around each shot so the App Store cards look polished.
#
# NOTE: the `TinyBoothUITests` target referenced by `scheme` below has not been
# created yet, so `fastlane screenshots` cannot run as-is. See fastlane/README.md.

devices([
  "iPad Pro (12.9-inch) (6th generation)",
  "iPhone 15 Pro Max",
  "iPhone 11"
])

languages([
  "en-US"
])

# Where the captured PNGs land (relative to the repo root).
output_directory("./fastlane/screenshots")

# UI test scheme. `expo prebuild` only generates the `TinyBooth` app scheme —
# this UI-test scheme must be added in Xcode before the lane will run.
scheme("TinyBoothUITests")

# Build the app once per device family rather than per device.
reinstall_app(true)

# Reset the simulator between runs so the app is captured in its true
# first-launch state (permission primer, empty Start screen).
erase_simulator(true)

# Snapshot picks up the localized strings to overlay on the bottom of the
# image when `frameit` runs. Strings live in `fastlane/screenshots/title.strings`.
override_status_bar(true)
