{
  "expo": {
    "name": "TinyBooth",
    "slug": "tinybooth",
    "version": "2.0.5",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "tinybooth",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF7EE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codesquad.tinybooth",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "privacyManifests": {
        "PrivacyInfoPath": "./ios/TinyBooth/PrivacyInfo.xcprivacy"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "TinyBooth uses the camera to take photos in the booth. Photos stay on this device unless you connect the booth to an event.",
        "NSPhotoLibraryAddUsageDescription": "TinyBooth saves every strip to your Photos library so you have a copy you can share or download later.",
        "NSPhotoLibraryUsageDescription": "TinyBooth needs photo access so it can save the strips it composes for you.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.codesquad.tinybooth",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF7EE"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "TinyBooth uses your camera to take photostrips.",
          "enableMicrophonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "TinyBooth needs photo access to save your photostrips.",
          "savePhotosPermission": "TinyBooth saves your photostrips to your camera roll when you tap Save.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0ed0282-f1d9-411e-a703-8cf671851ef6"
      }
    },
    "owner": "dorkycam"
  }
}
