{
  "expo": {
    "name": "TinyBooth",
    "slug": "tinybooth",
    "version": "0.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "tinybooth",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF7EE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codesquad.tinybooth",
      "infoPlist": {
        "NSCameraUsageDescription": "TinyBooth uses your camera to take photostrips.",
        "NSPhotoLibraryAddUsageDescription": "TinyBooth saves your photostrips to your camera roll when you tap Save.",
        "NSPhotoLibraryUsageDescription": "TinyBooth needs photo access to save your photostrips."
      }
    },
    "android": {
      "package": "com.codesquad.tinybooth",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF7EE"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "TinyBooth uses your camera to take photostrips.",
          "enableMicrophonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "TinyBooth needs photo access to save your photostrips.",
          "savePhotosPermission": "TinyBooth saves your photostrips to your camera roll when you tap Save.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
