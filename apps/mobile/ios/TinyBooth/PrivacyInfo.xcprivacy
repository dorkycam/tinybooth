<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PrivacyInfo.xcprivacy

  Apple required this file for any new App Store submission as of Spring
  2024. It must declare every "required reason" API the app (or a linked
  framework) calls, plus the data types collected and tracking domains used.

  Sources:
    https://developer.apple.com/documentation/bundleresources/privacy_manifest_files
    https://developer.apple.com/documentation/bundleresources/privacy_manifest_files/describing_use_of_required_reason_api

  See docs/privacy-manifest.md for the per-Expo-module mapping that explains
  why each entry is here.
-->
<plist version="1.0">
<dict>
  <!-- Tracking domains. None: TinyBooth does not use any third-party
       tracking SDK. Sentry + PostHog (when added) ship their own privacy
       manifests; we do not duplicate them here. -->
  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyTrackingDomains</key>
  <array/>

  <!-- Data types collected. Mirrors the App Store privacy questionnaire in
       docs/privacy-labels.md. -->
  <key>NSPrivacyCollectedDataTypes</key>
  <array>
    <!-- Photos: collected only when the user uploads to a paid Event.
         Standalone strips never leave the device. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePhotosorVideos</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- Email: collected when the host signs in via Supabase Auth, or when
         a guest opts into "email me my strip" delivery. Linked to the host
         identity; not linked for anon guests. We declare the Linked variant
         because the more inclusive label covers both. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeEmailAddress</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- Phone Number: only when a guest opts into SMS strip delivery. Not
         linked because we never store it past delivery confirmation. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePhoneNumber</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- User ID: Supabase auth user id stored locally and sent on each
         authenticated request. Linked to identity. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeUserID</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- Purchase History: from RevenueCat. Linked to host identity. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePurchaseHistory</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- Crash Data + Performance Data: from Sentry once it is wired (Phase
         6 H follow-up). Both not linked because Sentry is configured with
         user-id off in production builds. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeCrashData</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePerformanceData</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>
  </array>

  <!-- Required reason API declarations. One entry per API category Apple
       flags. Each entry lists the reason codes Apple accepts for that
       category. -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <!-- UserDefaults. Reason CA92.1: "Access info from same app, per the
         documentation." Used by AsyncStorage (settings, what's-new flag,
         RevenueCat cache). -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>CA92.1</string>
      </array>
    </dict>

    <!-- File Timestamp. Reason C617.1: "Inside app container." Expo's media
         library + Skia bridge stat local files when composing strips. -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>C617.1</string>
      </array>
    </dict>

    <!-- Disk Space. Reason E174.1: "Display to user the amount of disk
         space available." We surface "low disk space" before saving a
         strip to Camera Roll so the print path does not silently fail. -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>E174.1</string>
      </array>
    </dict>

    <!-- System Boot Time. Reason 35F9.1: "Measure elapsed time between
         events that occur within the app." Reanimated + RevenueCat both
         call this for monotonic timing. -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>35F9.1</string>
      </array>
    </dict>

    <!-- Active Keyboards. Not used. Apple does not require an empty entry,
         but listing it clears any third-party-framework false positive in
         App Review. Reason 3EH4.1: "App offers Custom Keyboard." We do
         NOT, so we omit this entry entirely; left as a comment so future
         reviewers know we considered it. -->
  </array>
</dict>
</plist>
