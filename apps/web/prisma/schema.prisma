// TinyBooth Postgres schema. See docs/plan.md section 3.2 for the full design.
//
// Carries over Event, Post, Photo from the original TinyWall schema and adds
// User, Strip, CustomMessage, Purchase, Subscription, plus the EventTier enum.
// Designed for Supabase Row-Level Security; policies are defined in Phase 3
// migrations.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
  output        = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Authenticated user. Mirrors Supabase auth.users via trigger; we read this
// table from app code. Anonymous TinyWall guests are not Users.
model User {
  id            String         @id @default(uuid())
  email         String         @unique
  displayName   String?
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  events        Event[]
  subscriptions Subscription[]
  purchases     Purchase[]
}

// Note: Export.userId is intentionally a free string (matches the user id we
// stash from auth) without a Prisma relation, so an in-flight export does not
// block account deletion. The cleanup cron sweeps orphan rows.

// Event is the cross-product unit. Owned by a User, or null for free anonymous
// TinyWall rooms. Branding propagates to TinyBooth strips and TinyWall TVs.
model Event {
  id              String          @id @default(cuid())
  ownerId         String?
  owner           User?           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  slug            String          @unique
  tier            EventTier       @default(FREE)
  startsAt        DateTime?
  endsAt          DateTime?
  retainUntil     DateTime
  branding        Json            @default("{}")
  settings        Json            @default("{}")
  emailDeliveries Int             @default(0)
  smsDeliveries   Int             @default(0)
  // One-time token issued at creation time so an anon creator can later claim
  // ownership of a free event by signing in. Cleared on first successful claim.
  claimToken      String?
  claimedAt       DateTime?
  createdAt       DateTime        @default(now())
  posts           Post[]
  strips          Strip[]
  customMessages  CustomMessage[]
  purchases       Purchase[]
  exports         Export[]

  @@index([slug])
  @@index([ownerId, createdAt])
  @@index([retainUntil])
}

// Post is a single TinyWall guest upload submission. Each post can hold one or
// more Photos (a guest who uploaded three pictures at once).
model Post {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  caption       String?
  uploaderToken String?
  approved      Boolean  @default(true)
  createdAt     DateTime @default(now())
  photos        Photo[]

  @@index([eventId, createdAt])
}

// Photo is a single media file attached to a Post (TinyWall) or a Strip
// (TinyBooth). Exactly one of postId or stripId is set.
model Photo {
  id         String   @id @default(cuid())
  postId     String?
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  stripId    String?
  strip      Strip?   @relation(fields: [stripId], references: [id], onDelete: Cascade)
  url        String
  storageKey String
  mediaType  String   @default("image")
  width      Int      @default(0)
  height     Int      @default(0)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([postId])
  @@index([stripId])
}

// Strip is a rendered TinyBooth photostrip. Standalone strips (no event tied)
// never upload to the cloud and have eventId = null.
model Strip {
  id               String   @id @default(cuid())
  eventId          String?
  event            Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  layout           String
  watermarkRemoved Boolean  @default(false)
  igShareUrl       String?
  createdAt        DateTime @default(now())
  photos           Photo[]

  @@index([eventId, createdAt])
}

// CustomMessage is a host-added message string that joins the random pool for
// a single event. Paid-tier feature.
model CustomMessage {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([eventId])
}

// Purchase records a consumable IAP or web Stripe charge applied to an event
// (Event Pass) or to a single strip (Strip Unlock).
model Purchase {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  eventId     String?
  event       Event?   @relation(fields: [eventId], references: [id])
  product     String
  source      String
  externalId  String
  amountCents Int
  currency    String   @default("USD")
  createdAt   DateTime @default(now())

  @@unique([source, externalId])
  @@index([userId, createdAt])
}

// Subscription is reserved for the year-2 Pro Host plan. Schema only at launch.
model Subscription {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  product     String
  status      String
  renewsAt    DateTime?
  cancelledAt DateTime?
  source      String
  externalId  String
  createdAt   DateTime  @default(now())
}

// Export records an asynchronous bulk-download job for an event. The dashboard
// kicks one off, the background job streams photos out of object storage,
// builds a zip, uploads it back, and stores the signed URL on the row.
model Export {
  id          String       @id @default(cuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  status      ExportStatus @default(PENDING)
  storageKey  String?
  signedUrl   String?
  expiresAt   DateTime?
  errorMsg    String?
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  @@index([eventId])
  @@index([userId, createdAt])
  @@index([expiresAt])
}

enum EventTier {
  FREE
  EVENT_PASS
  EVENT_PASS_PLUS
}

enum ExportStatus {
  PENDING
  RUNNING
  READY
  FAILED
}
