{
  "name": "@tinybooth/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TinyBooth single-binary CLI. One command for every infra op (setup, deploy, migrate, release, env, logs, seed, doctor).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "tinybooth": "./src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./program": "./src/program.ts"
  },
  "scripts": {
    "lint": "echo \"lint stub\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "echo \"no build (consumed via tsx)\"",
    "tinybooth": "tsx src/index.ts"
  },
  "dependencies": {
    "@tinybooth/billing": "workspace:*",
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "ora": "^8.1.1",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@tinybooth/config": "workspace:*",
    "@types/node": "^20.11.30",
    "@types/prompts": "^2.4.9",
    "@vitest/coverage-v8": "^1.6.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
